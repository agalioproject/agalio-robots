# REQUIRED for control
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LIVE only — leave empty for paper
WALLET_PRIVATE_KEY=

# true = paper (default). false = real money
DRY_RUN=true

# Optional: extra / paid RPCs (comma-separated)
# RPC_URLS=https://api.mainnet-beta.solana.com,https://solana-rpc.publicnode.com

# Optional persistence (Railway-safe). Run supabase.sql once.
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# STARTING values. Everything below can be changed live in Telegram → Settings;
# once you change it there, Telegram wins over these.
MAX_CONCURRENT=1            # max open positions
MAX_DAILY_LOSS_PCT=25
REQUIRE_NO_AUTHORITIES=true
BUY_SLIPPAGE_PCT=15
SELL_SLIPPAGE_PCT=30
SELL_SLIPPAGE_MAX_PCT=55
BUY_PRIORITY_FEE_SOL=0.0003
SELL_PRIORITY_FEE_SOL=0.0003

# Env-only (advanced)
MIN_POSITION_SOL=0.01
SOL_FEE_RESERVE=0.03
# SELL_RETRIES=6
# PRICE_POLL_MS=8000

# Paper
DRY_RUN_BALANCE_SOL=1
